<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- Home Screen Container -->
    <LinearLayout
        android:id="@+id/homeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <!-- SpotDeck Logo/Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="38sp"
            android:textColor="@color/primary"
            android:fontFamily="sans-serif-light"
            android:layout_marginBottom="8dp" />

        <!-- Status Info Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <!-- Current Time -->
            <TextView
                android:id="@+id/currentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="24sp"
                android:textColor="@color/on_background_secondary"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="24dp" />

            <!-- Battery Level -->
            <TextView
                android:id="@+id/batteryLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔋 --%"
                android:textSize="24sp"
                android:textColor="@color/on_background_secondary"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <!-- Large Spotify Logo -->
        <ImageView
            android:id="@+id/spotifyIcon"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginHorizontal="32dp"
            android:src="@drawable/spotify_logo"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_marginBottom="32dp"
            android:contentDescription="@string/launch_spotify" />

        <!-- Instruction Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/swipe_up_instruction"
            android:textColor="@color/on_background_secondary"
            android:textSize="14sp"
            android:layout_marginTop="32dp"
            android:gravity="center" />

    </LinearLayout>

    <!-- App List Container -->
    <LinearLayout
        android:id="@+id/appListContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- App List Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="@color/surface">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/apps"
                android:textSize="20sp"
                android:textColor="@color/on_surface"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/swipe_down_instruction"
                android:textColor="@color/on_surface_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Apps RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appListRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false" />

    </LinearLayout>

</RelativeLayout>